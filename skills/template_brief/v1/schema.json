{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateBrief",
  "type": "object",
  "required": ["topic", "summary"],
  "properties": {
    "topic": {"type": "string", "maxLength": 120},
    "brand": {"type": "string", "maxLength": 80},
    "purpose": {"type": "string", "enum": ["feature", "product", "project", "initiative", "report", "other"]},
    "audience": {"type": "string", "maxLength": 120},
    "summary": {"type": "string", "minLength": 40},
    "key_points": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "maxLength": 200}},
    "tone": {"type": "string", "maxLength": 120}
  }
}
