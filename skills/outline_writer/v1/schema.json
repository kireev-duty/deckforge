{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckOutline",
  "type": "object",
  "required": ["title", "purpose", "slides"],
  "properties": {
    "title": {"type": "string"},
    "purpose": {"type": "string", "enum": ["feature", "product", "project", "initiative", "report", "other"]},
    "audience": {"type": "string"},
    "language": {"type": "string"},
    "slides": {
      "type": "array",
      "minItems": 3,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["idx", "archetype", "title"],
        "properties": {
          "idx": {"type": "integer"},
          "archetype": {"type": "string"},
          "title": {"type": "string", "maxLength": 120},
          "subtitle": {"type": ["string", "null"]},
          "bullets": {"type": "array", "maxItems": 6, "items": {"type": "string"}},
          "paragraphs": {"type": "array", "items": {"type": "string"}},
          "kpis": {
            "type": "array", "maxItems": 4,
            "items": {"type": "object", "required": ["value", "label"],
                      "properties": {"value": {"type": "string"}, "label": {"type": "string"}}}
          },
          "chart": {
            "type": ["object", "null"],
            "required": ["kind", "title", "categories", "series"],
            "properties": {
              "kind": {"type": "string", "enum": ["bar", "column", "line", "pie", "doughnut", "area"]},
              "title": {"type": "string"},
              "categories": {"type": "array", "items": {"type": "string"}},
              "series": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}}},
              "unit": {"type": ["string", "null"]},
              "x_label": {"type": ["string", "null"]},
              "y_label": {"type": ["string", "null"]}
            }
          },
          "table": {
            "type": ["object", "null"],
            "required": ["header", "rows"],
            "properties": {
              "header": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
              "rows": {"type": "array", "maxItems": 7, "items": {"type": "array", "items": {"type": "string"}}}
            }
          },
          "image": {
            "type": ["object", "null"],
            "properties": {"prompt": {"type": ["string", "null"]}, "alt": {"type": "string"}}
          },
          "steps": {"type": "array", "maxItems": 6, "items": {"type": "string"}},
          "quote": {"type": ["string", "null"]},
          "quote_author": {"type": ["string", "null"]},
          "speaker_notes": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
