# Рабочая конфигурация проекта без ключа: все колоды в examples/ сгенерированы с этими значениями
# (сервис OpenRouter, Qwen3.8-27B на текст и зрение, FLUX.2 [klein] 4B на картинки).
# cp .env.example .env → вписать LLM_API_KEY. Параметры вызовов (temperature, max_tokens) — skills/<name>/v1/skill.yaml,
# сводка — README «Инференс и модели», docs/MODELS.md.

# ── LLM / VLM ──────────────────────────────────────────────────────────────────
# OpenAI-совместимый endpoint. Только модели с открытыми весами (Apache 2.0 / MIT), ≤35B.
# Проверено в день 1: Qwen3.8-27B (Apache 2.0, текст+изображения) доступна на OpenRouter.
# В топ-10 переключиться на инференс VK: поменять LLM_BASE_URL/LLM_API_KEY, модель та же.
# Ключ с https://openrouter.ai/settings/keys — вписывать ТОЛЬКО в .env, не сюда. Комментарии — только отдельной
# строкой: `docker run --env-file` не отрезает хвост « # …» и отправит его в API вместе с ключом.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b-20260814
VLM_MODEL=qwen/qwen3.8-27b-20260814

# ── Text-to-image (задача со звёздочкой, ≤20B) ────────────────────────────────
# По умолчанию — FLUX.2 [klein] 4B (Apache 2.0) на том же OpenRouter тем же ключом: T2I_BASE_URL и T2I_API_KEY
# оставить пустыми. Другой провайдер (Together: FLUX.1-schnell, vLLM) — задать оба. Чтобы отключить картинки: T2I_MODEL=
T2I_BASE_URL=
T2I_API_KEY=
T2I_MODEL=black-forest-labs/flux.2-klein-4b

# ── Рендер (LibreOffice). Пусто — автопоиск. ──────────────────────────────────
SOFFICE_PATH=

# ── Ограничения генерации ─────────────────────────────────────────────────────
# Бюджет времени на весь прогон — три варианта вместе, от старта (ТЗ: ≤ 5 мин); прежнее имя DECK_TIME_BUDGET_S
# тоже читается. Колоды собираются параллельно (1 — по очереди).
RUN_TIME_BUDGET_S=300
RUN_MAX_PARALLEL_DECKS=3
# Параллельных вызовов LLM внутри колоды (судья по слайдам, картинки)
DECK_MAX_PARALLEL_LLM=4
# Общий лимит одновременных запросов к провайдеру на все колоды; 0 — без лимита (для инференса с лимитом RPS)
LLM_MAX_CONCURRENCY=0
